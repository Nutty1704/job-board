# This is deliberately not a secret file. Populate the Adzuna secret directly
# in AWS after apply; never place the API key or app ID in Terraform variables.

ingestion_lambda_s3_bucket = "replace-with-artifact-bucket"
ingestion_lambda_s3_key    = "lambdas/ingestion/latest.zip"
# Set this after each uploaded artifact when the bucket has versioning enabled.
# ingestion_lambda_s3_object_version = "replace-with-s3-version-id"

matching_lambda_s3_bucket = "replace-with-artifact-bucket"
matching_lambda_s3_key    = "lambdas/matching/latest.zip"
# matching_lambda_s3_object_version = "replace-with-s3-version-id"

resume_lambda_s3_bucket = "replace-with-artifact-bucket"
resume_lambda_s3_key    = "lambdas/resume/latest.zip"
# resume_lambda_s3_object_version = "replace-with-s3-version-id"

# Optional: SNS topic ARNs for CloudWatch alarms.
# alarm_actions = ["arn:aws:sns:ap-southeast-2:123456789012:job-board-alerts"]
